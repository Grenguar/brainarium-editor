{
  "name": "brainarium",
  "productName": "Brainarium",
  "version": "0.1.7",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "description": "A local-first editor for the files you already trust.",
  "author": "Brainarium contributors",
  "homepage": "https://github.com/Grenguar/brainarium-editor",
  "main": ".webpack/main",
  "scripts": {
    "predev": "pnpm run build:rust",
    "prestart": "pnpm run build:rust",
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "doctor:linux": "node scripts/linux-sandbox-doctor.mjs",
    "build:rust": "cargo build --release --manifest-path rust/Cargo.toml",
    "package": "pnpm run build:rust && electron-forge package",
    "make": "pnpm run build:rust && electron-forge make",
    "make:local-update": "pnpm version patch --no-git-tag-version && pnpm run make",
    "format": "prettier --write package.json pnpm-workspace.yaml forge.config.js webpack.rules.js webpack.main.config.js webpack.renderer.config.js tsconfig.json eslint.config.mjs playwright.config.ts vitest.config.mts src tests .github/workflows",
    "format:check": "prettier --check package.json pnpm-workspace.yaml forge.config.js webpack.rules.js webpack.main.config.js webpack.renderer.config.js tsconfig.json eslint.config.mjs playwright.config.ts vitest.config.mts src tests .github/workflows",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run package && playwright test",
    "check:rust": "cargo fmt --manifest-path rust/Cargo.toml --check && cargo clippy --manifest-path rust/Cargo.toml -- -D warnings && cargo test --manifest-path rust/Cargo.toml",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run check:rust && pnpm run build",
    "build": "pnpm run package"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/mdast": "4.0.4",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "css-loader": "7.1.5",
    "electron": "44.0.0",
    "eslint": "10.9.1",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "html-webpack-plugin": "5.6.8",
    "prettier": "3.9.6",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "webpack": "5.110.1",
    "webpack-cli": "7.2.3"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.9",
    "codemirror": "6.0.2",
    "electron-squirrel-startup": "1.0.1",
    "github-slugger": "2.0.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "hast-util-sanitize": "5.0.2",
    "mdast-util-find-and-replace": "3.0.2",
    "pdfjs-dist": "5.4.530",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-parse": "9.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sigma": "3.0.3",
    "unified": "11.0.5"
  }
}
