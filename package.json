{
  "name": "brainarium",
  "productName": "Brainarium",
  "version": "0.1.0",
  "description": "A local-first Markdown and CSV vault editor.",
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "format": "prettier --write package.json forge.config.js webpack.rules.js webpack.main.config.js webpack.renderer.config.js tsconfig.json eslint.config.mjs src",
    "format:check": "prettier --check package.json forge.config.js webpack.rules.js webpack.main.config.js webpack.renderer.config.js tsconfig.json eslint.config.mjs src",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run package"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@eslint/js": "9.39.1",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "css-loader": "7.1.4",
    "electron": "44.0.0",
    "eslint": "9.39.1",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "html-webpack-plugin": "5.6.8",
    "prettier": "3.9.6",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "webpack": "5.109.2",
    "webpack-cli": "7.2.2"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
