{
  "mcpServers": {
    "brainarium-vault": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/brainarium-mcp",
        "brainarium-mcp"
      ],
      "env": {
        "BRAINARIUM_VAULT": "/absolute/path/to/the-same-vault-selected-in-Brainarium",
        "BRAINARIUM_MCP_ALLOW_WRITE": "true",
        "BRAINARIUM_MCP_MAX_FILE_BYTES": "5242880"
      }
    }
  }
}
